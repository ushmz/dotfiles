abbr -g "venv"="sourse_pyenv"
abbr "..."="cd ../../"
abbr "...."="cd ../../../"
abbr "c"="clear"
abbr "dot"="cd ~/dotfiles"
abbr "pnpm install"="pnpm install --frozen-lockfile"
abbr "so"="source"
abbr "soenv"="source ~/.zshenv"
abbr "soprof"="source ~/.zprofile"
abbr "sorc"="source ~/.zshrc"
abbr "sudo"="sudo -E "
abbr "wget"="wget --hsts-file=\"\${XDG_CACHE_HOME}/wget-hsts\""
abbr "zprofile"="vi ~/dotfiles/zprofile.d"
abbr "zshenv"="vi ~/.zshenv"
abbr "zshrc"="vi ~/dotfiles/zshrc.d"
