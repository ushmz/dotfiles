#!/usr/bin/env bash

if [ -z "$1" ]; then
    echo "Usage: git review-wt <branch>"
    exit 1
fi

BRANCH="$1"
REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_NAME=$(basename "$REPO_ROOT")
BRANCH_SLUG="${BRANCH//\//-}"
WORKTREE_PATH="${REPO_ROOT}/../${REPO_NAME}-${BRANCH_SLUG}"

git fetch origin "${BRANCH}" && git worktree add "${WORKTREE_PATH}" "${BRANCH}"
